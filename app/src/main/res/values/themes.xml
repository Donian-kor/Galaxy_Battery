<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        기본 테마 — 앱 실행 시 윈도우 배경색으로만 사용된다.
        플랫폼 Material 테마를 상속받는다 (AppCompat 불필요).
        UI는 Compose가 다 그리며, 이 테마는 사전 렌더링 윈도우 크롬만 제어한다.
    -->
    <style name="Theme.GalaxyBattery" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">#FAFAFA</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
